#include "Program.h"


Program::Program(std::string fnameUlazni, std::string fnameIzlazni) {
	this->fname = fname;

	std::ifstream f(fname, std::ios::binary);

	if(!f.is_open())
	{
		std::cout << "Neuspesno otvoren fajl";
		return;
	}

	char c;

	while(f.get(c))
	{
		nizFrekvencija[static_cast<unigned char>(c)]++;
	}

	f.close();

	stablo.kreirajStablo(nizFrekvencija);

	kodirajUFajl(fnameUlazni, fnameIzlazni);
}

