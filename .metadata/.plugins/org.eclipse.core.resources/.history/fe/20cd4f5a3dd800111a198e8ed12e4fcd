	std::ifstream f(fnameUlazni, std::ios::binary);

	if(!f.is_open())
	{
		std::cout << "Neuspesno otvoren fajl";
		return;
	}

	char c;

	while(f.get(c))
	{
		nizFrekvencija[static_cast<unsigned char>(c)]++;
	}

	f.close();

	stablo.kreirajStablo(nizFrekvencija);

	kodirajUFajl(fnameUlazni, fnameIzlazni);
}

